<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="pub.chara.miuipadmeta.modern.permission.CONFIGURE"
        android:protectionLevel="signature" />
    <uses-permission android:name="pub.chara.miuipadmeta.modern.permission.CONFIGURE" />
    <application
        android:name=".ScopeApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:icon="@android:drawable/ic_menu_manage">
        <provider android:name=".ScopeServiceProvider"
            android:authorities="pub.chara.miuipadmeta.modern.XposedService"
            android:exported="true" />
        <activity android:name=".SettingsActivity" android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
